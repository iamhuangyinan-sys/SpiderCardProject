# ======================================== #
#           Unity .gitignore                #
# ======================================== #

# ---------- Unity 自动生成 ---------- #
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# ---------- IDE / 编辑器 ---------- #
.idea/
.vs/
.VSCodeCounter/
*.userprefs
*.csproj
*.sln
*.user
*.pidb
*.pdb
*.suo

# ---------- 操作系统 ---------- #
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- 其他 ---------- #
*.log
*.tmp
*.crashreport
*.apk
*.aab
*.unitypackage
*.app

# ---------- 保留 .meta 文件（仅对 tracked 资产） ---------- #
# 不要整体忽略 .meta，因为 Unity 需要它们

# ---------- 本地私有文档（不纳入版本管理） ---------- #
# 本地生成的文档统一放 private_doc，不进 git
private_doc/

# ---------- Python 脚本产物 ---------- #
__pycache__/
*.py[cod]
