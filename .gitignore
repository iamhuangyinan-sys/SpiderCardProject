# ======================================== #
#           Unity .gitignore                #
# ======================================== #

# ---------- Unity 自动生成 ---------- #
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# ---------- IDE / 编辑器 ---------- #
.idea/
.vs/
.VSCodeCounter/
*.userprefs
*.csproj
*.sln
*.user
*.pidb
*.pdb
*.suo

# ---------- 操作系统 ---------- #
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- 其他 ---------- #
*.log
*.tmp
*.crashreport
*.apk
*.aab
*.unitypackage
*.app

# ---------- 保留 .meta 文件（仅对 tracked 资产） ---------- #
# 不要整体忽略 .meta，因为 Unity 需要它们
